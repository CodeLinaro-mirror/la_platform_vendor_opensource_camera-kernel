config SPECTRA_ISP
	bool "enable camera ISP modele"
	help
	  This is enabling camera ISP module.
	  IFE camera driver file be included.
	  This will enable camera ISP driver to handle IFE driver.
	  Core camera driver to handle VFE HW.

config SPECTRA_TFE
	bool "enable camera tfe modele"
	help
	  This is enabling camera tfe module.
	  tfe module files will be included to enable tfe based driver,
	  files.

config SPECTRA_OPE
	bool "enable camera OPE modele"
	help
	  This is enabling camera OPE module.
	  Camera OPE driver file be included.
	  This will enable camera OPE driver to interact with,
	  other modules.

config SPECTRA_SENSOR
	bool "enable camera sensor modele"
	help
	  This is enabling camera sensor module.
	  sensor module files will be included to enable the driver.
	  eeprom, flash, csiphy all other module will be included
	  to make the sensor functional.

config SPECTRA_SECURE_CAMERA_25
	bool "enable secure camera 2.5"
	help
		This config enables 2.5 secure camera
		feature that allows the usage of non contiguous
		buffers for the secure camera images by
		lending the buffers to a trusted virtual machine.

config RT_MAP_WORKER_WORKQ
	bool "enable workqueue bottom half to replace default tasklet"
	help
		This config enables the use of workqueue within worker wrapper
		for realtime needs.
		Which supports the replacement of the default tasklet option
		with workqueue for bottom half.

config RT_MAP_WORKER_KTHREAD
	bool "enable kthread bottom half to replace default tasklet"
	help
		This config enables the use of kthread within worker wrapper
		for realtime needs.
		It supports the replacement of the default tasklet option
		with kthread for bottom half

config NRT_MAP_WORKER_KTHREAD
	bool "enable kthread bottom half to replace default workqueue solution"
	help
		This config enables the use of kthread within worker wrapper
		for non-realtime needs.
		It supports the replacement of the default workqueue option
		with kthread for bottom half

