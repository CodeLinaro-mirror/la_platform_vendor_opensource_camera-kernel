    name = "camera_src_headers",
    hdrs = glob(driver_header_globs),
    includes = camera_driver_includes + [
        "common",
        ".",
    ],
)

ddk_headers(
    name = "camera_dt_bindings",
    hdrs = ["camera/dt-bindings/msm-camera.h"],
    includes = ["camera", "camera/dt-bindings"],
)

genrule(
    name = "camera_banner_header",
    srcs = [],
    outs = ["camera/drivers/cam_generated.h"],
    cmd = """
      {
        printf '#define CAMERA_COMPILE_TIME "%s"\n' "$$(date)"
        printf '#define CAMERA_COMPILE_BY "%s"\n' "$$(whoami)"
        printf '#define CAMERA_COMPILE_HOST "%s"\n' "$$(uname -n)"
      } > "$@"
    """
)

ddk_headers(
    name = "camera_banner",
    hdrs = [":camera_banner_header"],
    includes = ["camera/drivers"],
)

ddk_headers(
    name = "camera_headers",
    hdrs = [
        ":camera_src_headers",
        ":camera_uapi_headers",
        ":camera_dt_bindings",
        ":camera_banner",
    ],
)

load(":camera_modules.bzl", "define_camera_module")

define_camera_module()

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
string_flag(
    name = "project_name",
    build_setting_default = "none",
)
config_setting(
    name = "no_project",
    flag_values = {":project_name": "none"},
)
config_setting(
    name = "shikra",
    flag_values = {":project_name": "shikra"},
)
